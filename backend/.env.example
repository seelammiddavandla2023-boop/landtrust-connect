# Every value here has a working default. The prototype runs with no .env at all.

# SQLite by default, at data/landtrust.db. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/landtrust

# DEMO = embedded text layer (no OCR engine needed). OCR = Tesseract. LLM = Review-3.
EXTRACTION_MODE=DEMO

# Comma-separated origins allowed to call the API from a browser. Lock this to the
# deployed frontend once its URL is known:
# CORS_ORIGINS=https://landtrust-connect.vercel.app
CORS_ORIGINS=*

# Reserved for Review-3 LLM-assisted extraction and answer phrasing. The evidence
# assistant is fully functional without them.
# LLM_API_KEY=
# LLM_MODEL=
