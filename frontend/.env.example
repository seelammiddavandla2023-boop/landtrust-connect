# Leave unset for local development: next.config.mjs proxies /api to the local
# backend, so the browser makes same-origin requests and CORS never applies.
#
# Set this in production (Vercel → Settings → Environment Variables) to the public
# URL of the deployed API, with no trailing slash. It is inlined at build time, so
# changing it requires a redeploy.
#
# NEXT_PUBLIC_API_URL=https://landtrust-connect-api.onrender.com
